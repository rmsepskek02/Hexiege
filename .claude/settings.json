{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat CLAUDE.md",
            "statusMessage": "CLAUDE.md 로딩 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[체크] 에이전트 호출 전: .claude/MEMORY.md 내용을 프롬프트에 포함했는가?'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "mcp__mcp-unity__update_component",
      "Bash(npx:*)",
      "Bash(git rm:*)",
      "Bash(where claude:*)",
      "Bash(python3 -c \"import json,sys; d=json.load\\(sys.stdin\\); print\\(json.dumps\\({k:v for k,v in d.items\\(\\) if ''''mcp'''' in k.lower\\(\\) or ''''server'''' in k.lower\\(\\)}, indent=2\\)\\)\")"
    ],
    "additionalDirectories": [
      "Assets/_Project/Docs/_Tasks"
    ]
  }
}
