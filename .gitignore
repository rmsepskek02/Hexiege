# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/

# Firebase Unity SDK (용량 대형 - 로컬 임포트로 재설치)
Assets/Firebase/
Assets/Firebase.meta

# Firebase가 설치하는 에디터 리소스 (아이콘 등)
Assets/Editor Default Resources/Firebase/
Assets/Editor Default Resources/Firebase.meta

# Firebase iOS/tvOS 플러그인 (모바일 Android 전용 프로젝트이므로 불필요)
Assets/Plugins/iOS/Firebase/
Assets/Plugins/iOS/Firebase.meta
Assets/Plugins/tvOS/Firebase/
Assets/Plugins/tvOS/Firebase.meta

# Google Play Games Plugin for Unity (용량 대형 - 로컬 임포트로 재설치)
Assets/GooglePlayGames/
Assets/GooglePlayGames.meta

# GPGS가 설치하는 Android 매니페스트 라이브러리
Assets/Plugins/Android/GooglePlayGamesManifest.androidlib/
Assets/Plugins/Android/GooglePlayGamesManifest.androidlib.meta

# EDM4U(External Dependency Manager) — 기기마다 .meta가 달라져 충돌 유발
Assets/ExternalDependencyManager/
Assets/ExternalDependencyManager.meta

# EDM4U(External Dependency Manager)가 Android Resolver 실행 시 자동 재생성
Assets/GeneratedLocalRepo/
Assets/GeneratedLocalRepo.meta

# EDM4U Force Resolve 시 현재 PC의 절대경로로 재작성됨 → 커밋하면 다른 PC에서 빌드 실패
Assets/Plugins/Android/settingsTemplate.gradle
Assets/Plugins/Android/settingsTemplate.gradle.meta

# Google Version Handler 설정 — EDM4U가 기기별로 자동 갱신
ProjectSettings/GvhProjectSettings.xml
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Unity IL2CPP build backup (빌드 시 자동 생성, 커밋 불필요)
Build_BackUpThisFolder_ButDontShipItWithYourGame/
apk_BackUpThisFolder_ButDontShipItWithYourGame/

# Unity Burst debug output (빌드/디버그 시 자동 생성, 커밋 불필요)
Hexiege_BurstDebugInformation_DoNotShip/

# Unity 퍼포먼스 테스트 자동 기록 (실행할 때마다 자동 갱신)
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta

# Visual Studio 솔루션 파일 (개발환경마다 자동 갱신)
*.slnx

# Claude Code 내부 임시 폴더
.claude/worktrees/

# 로컬 개발환경 전용 파일
.vsconfig
.claude/settings.local.json

# Unity Performance Test 자동 생성 파일
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta
